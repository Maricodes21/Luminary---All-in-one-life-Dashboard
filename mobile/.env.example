EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=luminary://spotify-callback
# Optional. Defaults to your Supabase Edge Function callback below.
# EXPO_PUBLIC_SPOTIFY_PREVIEW_REDIRECT_URI=https://your-project.supabase.co/functions/v1/spotify-preview-auth/callback

# Optional compact AI. For Expo Go field tests, use the desktop's LAN address
# and run Ollama with LAN access. Never expose this port to the public internet.
# EXPO_PUBLIC_LUMINARY_AI_URL=http://192.168.1.20:11434
# EXPO_PUBLIC_LUMINARY_AI_MODEL=gemma4:e4b
