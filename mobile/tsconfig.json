{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@luminary/design-system": [
        "../packages/design-system/src/index.ts"
      ],
      "@luminary/design-system/*": [
        "../packages/design-system/src/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
