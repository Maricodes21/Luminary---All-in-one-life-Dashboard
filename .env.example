# Copy this file to .env in any workspace that needs these values.
# Never commit .env files.

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Spotify (PKCE — no client secret on device)
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=your-spotify-client-id
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=luminary://spotify-callback

# Optional compact AI for local field tests. Use the desktop's LAN address,
# not localhost, when Expo Go runs on a phone.
# EXPO_PUBLIC_LUMINARY_AI_URL=http://192.168.1.20:11434
# EXPO_PUBLIC_LUMINARY_AI_MODEL=gemma4:e4b
